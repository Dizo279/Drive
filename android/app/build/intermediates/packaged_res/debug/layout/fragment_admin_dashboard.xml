<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/apple_light_gray">

    <!-- AppBar & Title -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        app:elevation="0dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:text="Bảng quản trị"
            android:textColor="@color/apple_black"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- TabLayout cho 2 tính năng chính -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tab_layout_admin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/white"
            app:tabIndicatorColor="@color/apple_blue"
            app:tabSelectedTextColor="@color/apple_blue"
            app:tabTextColor="@color/apple_gray" />
    </com.google.android.material.appbar.AppBarLayout>

    <!-- ViewPager2 chứa nội dung các tab -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager_admin"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>
